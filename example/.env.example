# Defaults (read through extra.runtime.dotenv_path in composer.json); the real
# environment, or .env.example.local, wins.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me
# Where Fixwire sends; without it, Fixwire does nothing.
FIXWIRE_DSN=
FIXWIRE_RELEASE=shop@1.0.0
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
MESSENGER_TRANSPORT_DSN=doctrine://default
INVENTORY_URL=http://localhost:8081
