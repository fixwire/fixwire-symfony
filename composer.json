{
  "name": "fixwire/symfony",
  "description": "Fixwire for Symfony: errors, traces, Messenger, Doctrine, the HTTP client and release health",
  "type": "symfony-bundle",
  "license": "MIT",
  "keywords": [
    "fixwire",
    "symfony",
    "bundle",
    "errors",
    "exceptions",
    "tracing",
    "opentelemetry",
    "monitoring"
  ],
  "require": {
    "php": ">=8.1",
    "fixwire/fixwire": "^0.1.1",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/event-dispatcher": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "doctrine/dbal": "^3.8 || ^4.0",
    "doctrine/doctrine-bundle": "^2.11 || ^3.0",
    "friendsofphp/php-cs-fixer": "^3.64",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0",
    "symfony/browser-kit": "^6.4 || ^7.0 || ^8.0",
    "symfony/console": "^6.4 || ^7.0 || ^8.0",
    "symfony/framework-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-client": "^6.4 || ^7.0 || ^8.0",
    "symfony/messenger": "^6.4 || ^7.0 || ^8.0",
    "symfony/monolog-bundle": "^3.10 || ^4.0",
    "symfony/security-bundle": "^6.4 || ^7.0 || ^8.0",
    "symfony/yaml": "^6.4 || ^7.0 || ^8.0"
  },
  "suggest": {
    "doctrine/doctrine-bundle": "SQL queries as breadcrumbs and spans",
    "symfony/http-client": "Outgoing requests as client spans, with trace headers",
    "symfony/messenger": "Messages handled by workers in their own scope, continuing the sender's trace"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://github.com/fixwire/fixwire-php"
    }
  ],
  "autoload": {
    "psr-4": {
      "Fixwire\\Symfony\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Fixwire\\Symfony\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse",
    "format": [
      "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
      "php-cs-fixer fix"
    ],
    "check-format": [
      "@putenv PHP_CS_FIXER_IGNORE_ENV=1",
      "php-cs-fixer fix --dry-run --diff"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "homepage": "https://fixwire.io",
  "support": {
    "issues": "https://github.com/fixwire/fixwire-symfony/issues",
    "source": "https://github.com/fixwire/fixwire-symfony"
  }
}
